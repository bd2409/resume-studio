# Copy to .env for local runs. Never commit real keys.
SITE_NAME=Resume Studio
SITE_URL=http://localhost:8000
OWNER_NAME=Bhargab
CONTACT_EMAIL=hello@example.com
CONTACT_PHONE=
BUSINESS_ADDRESS=India
PRICE_RUPEES=500

# AI (leave empty to run in sample/mock mode)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Razorpay (leave empty locally to get a "skip payment" test button)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
DEV_SKIP_PAYMENT=true

# Email via resend.com (optional)
RESEND_API_KEY=
EMAIL_FROM=Resume Studio <orders@yourdomain.com>

# /admin page password
ADMIN_PASSWORD=change-me

DATA_DIR=./data
