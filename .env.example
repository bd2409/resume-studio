# Copy to .env for local runs. Never commit real keys.
SITE_NAME=Resume Studio
SITE_URL=http://localhost:8000
OWNER_NAME=Bhargab
CONTACT_EMAIL=hello@example.com
CONTACT_PHONE=
BUSINESS_ADDRESS=India
PRICE_RUPEES=500

# AI (leave empty to run in sample/mock mode)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Cashfree Payment Gateway (leave empty locally to get a "skip payment" test button)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# production or sandbox
CASHFREE_ENV=production
DEV_SKIP_PAYMENT=true

# Email via resend.com (optional)
RESEND_API_KEY=
EMAIL_FROM=Resume Studio <orders@yourdomain.com>

# /admin page password
ADMIN_PASSWORD=change-me

DATA_DIR=./data

# Optional: HTML-tag verification codes (Search Console / Bing Webmaster). DNS verification needs neither.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Google sign-in for customer accounts (OAuth Web client ID). Leave empty to hide accounts.
GOOGLE_CLIENT_ID=
# Signs login cookies
SECRET_KEY=

# Other services (prices in rupees; defaults shown)
# PRICE_LINKEDIN=799
# PRICE_BUNDLE=1099
# PRICE_VERSION=199
# PRICE_PREMIUM=2999
# PRICE_INTERVIEW=499
# PRICE_OUTREACH=399
# PRICE_SALARY=299
# PRICE_CONTENT=999
# PRICE_CALL=1999
# PRICE_AUDIT=7999
# Scheduling link shown after a call or audit is paid for (Calendly, Google Calendar booking page, ...)
CALL_BOOKING_URL=
# Where booking, premium and college enquiry alerts go (defaults to CONTACT_EMAIL)
OWNER_EMAIL=
# PRICE_CLAUDE=2499
# Free AI resume checks per day (lead magnet), caps AI spend
# FREE_CHECKS_PER_DAY=40
